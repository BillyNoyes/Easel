<section class="page password">
  <h1>{{ shop.name | escape }}</h1>
  {% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <label for="StorefrontPassword-{{ section.id }}">{{ 'password.password' | t }}</label>
    <input id="StorefrontPassword-{{ section.id }}" type="password" name="password" autocomplete="current-password" required>
    <button type="submit">{{ 'password.enter' | t }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
