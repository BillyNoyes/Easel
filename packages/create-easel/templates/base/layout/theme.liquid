<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url | escape }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'easel.svg' | asset_url }}">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
    <style>
      :root { --theme-background: {{ settings.background }}; --theme-foreground: {{ settings.foreground }}; }
    </style>
    {% render 'easel-assets' %}
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
