{
  "name": "@blueprint/frame",
  "version": "0.0.0",
  "description": "A Vite build adapter for Shopify Liquid themes",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BillyNoyes/Frame.git"
  },
  "homepage": "https://github.com/BillyNoyes/Frame#readme",
  "bugs": "https://github.com/BillyNoyes/Frame/issues",
  "keywords": [
    "shopify",
    "liquid",
    "theme",
    "vite"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:examples && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm check",
    "test": "vitest run",
    "test:example:alpine-tailwind": "pnpm --dir examples/alpine-tailwind check",
    "test:example:react": "pnpm --dir examples/react check",
    "test:example:vanilla": "pnpm --dir examples/vanilla check",
    "test:example:vue": "pnpm --dir examples/vue check",
    "test:examples": "pnpm test:example:vanilla && pnpm test:example:alpine-tailwind && pnpm test:example:react && pnpm test:example:vue",
    "test:theme-check": "shopify theme check --path examples/vanilla --fail-level error && shopify theme check --path examples/alpine-tailwind --fail-level error && shopify theme check --path examples/react --fail-level error && shopify theme check --path examples/vue --fail-level error",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "alpinejs": "3.16.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
