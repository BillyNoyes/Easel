{% assign example_label = 'examples.label' | t %}
<section class="hero" data-counter>
  {% render 'badge', text: example_label %}
  <h1>{{ section.settings.heading }}</h1>
  <div>{{ section.settings.text }}</div>
  <div class="counter">
    <button type="button" data-decrease aria-label="{{ 'actions.decrease' | t }}">−</button>
    <output data-count>0</output>
    <button type="button" data-increase aria-label="{{ 'actions.increase' | t }}">+</button>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "default": "t:sections.hero.default_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero.text",
      "default": "t:sections.hero.default_text"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
