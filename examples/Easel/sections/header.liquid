<header class="site-header">
  <div class="page-width site-header__inner">
    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
    {% if section.settings.menu != blank %}
      <nav aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="site-header__links" role="list">
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
    <a href="{{ routes.cart_url }}">{{ 'cart.title' | t }} ({{ cart.item_count }})</a>
  </div>
</header>

{% stylesheet %}
  .site-header {
    border-bottom: 1px solid currentcolor;
  }

  .site-header__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__brand {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__links {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.menu"
    }
  ]
}
{% endschema %}
