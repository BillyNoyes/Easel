<section class="hero">
  <div class="page-width hero__inner">
    <h1>{{ section.settings.heading }}</h1>
    <div class="hero__text">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    padding-block: clamp(4rem, 12vw, 10rem);
  }

  .hero__inner {
    display: grid;
    max-width: 60rem;
    justify-items: start;
    gap: 1.5rem;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .hero__text {
    max-width: 42rem;
    font-size: 1.2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "default": "t:sections.hero.default_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero.text",
      "default": "t:sections.hero.default_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.button_label",
      "default": "t:sections.hero.default_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
