<section class="page-width product">
  <div class="product__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200' }}
    {% endif %}
  </div>
  <div class="product__details">
    <h1>{{ product.title }}</h1>
    {% render 'price', product: product %}
    <div>{{ product.description }}</div>
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}
          {{ 'actions.add_to_cart' | t }}
        {% else %}
          {{ 'product.unavailable' | t }}
        {% endif %}
      </button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .product {
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
  }

  .product__details {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .product {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": []
}
{% endschema %}
