{% assign current_year = 'now' | date: '%Y' %}
<footer class="site-footer">
  <div class="page-width">
    <p>{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</p>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid currentcolor;
    padding-block: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": []
}
{% endschema %}
